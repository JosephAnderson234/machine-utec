---
/** Enlaces a material web externo para profundizar. */
interface Item {
	href: string;
	titulo: string;
	tipo: string;
	texto: string;
}
interface Props {
	items: Item[];
}
const { items } = Astro.props;
---
<div class="recursos not-content">
	{items.map((it) => (
		<a href={it.href} target="_blank" rel="noopener noreferrer">
			<span class="tipo">{it.tipo}</span>
			<span>
				<b>{it.titulo}</b>
				<span class="d">{it.texto}</span>
			</span>
		</a>
	))}
</div>
